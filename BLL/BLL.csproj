  <!-- Copia la biblioteca al Bin del sitio web para que el Web Site la tome,
       junto con ML.NET y sus dependencias (los .dll que NuGet deja en la salida
       de BLL). BE, DAL y Servicios los copia cada proyecto, y Newtonsoft.Json
       ya lo trae el sitio. La biblioteca nativa de ML.NET (CpuMathNative.dll)
       no es un ensamblado .NET: va a Bin\x64 y Bin\x86 y la carga
       BLLPrediccionDemanda según la arquitectura del proceso. -->
  <Target Name="CopiarAlSitioWeb" AfterTargets="Build">
    <ItemGroup>
      <DllParaSitioWeb Include="$(TargetDir)*.dll" Exclude="$(TargetDir)*Native.dll;$(TargetDir)$(TargetFileName);$(TargetDir)BE.dll;$(TargetDir)DAL.dll;$(TargetDir)Servicios.dll;$(TargetDir)Newtonsoft.Json.dll" />
      <NativaX64ParaSitioWeb Include="$(ProjectDir)..\packages\Microsoft.ML.CpuMath.*\runtimes\win-x64\nativeassets\netstandard2.0\*.dll" />
      <NativaX86ParaSitioWeb Include="$(ProjectDir)..\packages\Microsoft.ML.CpuMath.*\runtimes\win-x86\nativeassets\netstandard2.0\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\IntelligentStock\Bin\" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\IntelligentStock\Bin')" />
    <Copy SourceFiles="@(DllParaSitioWeb)" DestinationFolder="$(ProjectDir)..\IntelligentStock\Bin\" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\IntelligentStock\Bin')" />
    <Copy SourceFiles="@(NativaX64ParaSitioWeb)" DestinationFolder="$(ProjectDir)..\IntelligentStock\Bin\x64\" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\IntelligentStock\Bin')" />
    <Copy SourceFiles="@(NativaX86ParaSitioWeb)" DestinationFolder="$(ProjectDir)..\IntelligentStock\Bin\x86\" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\IntelligentStock\Bin')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ProjectDir)..\IntelligentStock\Bin\" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb') And Exists('$(ProjectDir)..\IntelligentStock\Bin')" />
  </Target>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>Este proyecto hace referencia a los paquetes NuGet que faltan en este equipo. Use la restauración de paquetes NuGet para descargarlos. Para obtener más información, consulte http://go.microsoft.com/fwlink/?LinkID=322105. El archivo que falta es {0}.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('..\packages\Microsoft.ML.CpuMath.5.0.0\build\netstandard2.0\Microsoft.ML.CpuMath.props')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\Microsoft.ML.CpuMath.5.0.0\build\netstandard2.0\Microsoft.ML.CpuMath.props'))" />
    <Error Condition="!Exists('..\packages\Microsoft.ML.5.0.0\build\netstandard2.0\Microsoft.ML.props')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\Microsoft.ML.5.0.0\build\netstandard2.0\Microsoft.ML.props'))" />
    <Error Condition="!Exists('..\packages\Microsoft.ML.5.0.0\build\netstandard2.0\Microsoft.ML.targets')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\Microsoft.ML.5.0.0\build\netstandard2.0\Microsoft.ML.targets'))" />
  </Target>
